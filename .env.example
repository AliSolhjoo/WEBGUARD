# Development defaults. Replace SECRET_KEY and configure ALLOWED_HOSTS for deployment.
DEBUG=true
SECRET_KEY=dev-only-change-this-key-before-deployment
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=UTC

# Database: sqlite for local development; set DB_ENGINE=postgresql and the values below for production.
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3
DB_NAME=webguard
DB_USER=webguard
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Passive scanner limits. HEAD probes use only ports 80/443; a single same-origin HTTPS root GET may read at most 64 KiB of HTML for passive content checks. Redirects are same-host HTTPS only.
SCAN_TIMEOUT_SECONDS=8
SCAN_MAX_REDIRECTS=3
SCAN_TOTAL_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
